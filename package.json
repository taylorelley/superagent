{
  "name": "superagent",
  "version": "0.1.0",
  "description": "Superagent skills and runtime bootstrap for OpenCode",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/taylorelley/superagent.git"
  },
  "main": ".opencode/plugins/superagent.js",
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write '**/*.{js,mjs,cjs}'",
    "format:check": "prettier --check '**/*.{js,mjs,cjs}'"
  },
  "exports": {
    ".": {
      "import": "./.opencode/plugins/superagent.js"
    },
    "./server": {
      "import": "./.opencode/plugins/superagent.js"
    },
    "./tui": {
      "import": "./.opencode/tui/superagent-tui.js"
    }
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "skills",
    "tdd",
    "debugging",
    "collaboration",
    "workflow"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.1",
    "prettier": "^3.9.6"
  }
}
