{
  "name": "superagent",
  "version": "2026.11.1",
  "description": "Superagent skills and agent team for OpenCode, Claude Code and Codex",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/taylorelley/superagent.git"
  },
  "main": ".opencode/plugins/superagent.js",
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write '**/*.{js,mjs,cjs}'",
    "format:check": "prettier --check '**/*.{js,mjs,cjs}'"
  },
  "exports": {
    ".": {
      "import": "./.opencode/plugins/superagent.js"
    },
    "./server": {
      "import": "./.opencode/plugins/superagent.js"
    },
    "./tui": {
      "import": "./.opencode/tui/superagent-tui.js"
    },
    "./codex": {
      "import": "./codex/lib/adapter.js"
    }
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "skills",
    "tdd",
    "debugging",
    "collaboration",
    "workflow",
    "claude-code",
    "claude-code-plugin",
    "codex",
    "codex-plugin"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.1",
    "prettier": "^3.9.6"
  }
}
